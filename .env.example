# Copy to .env.local only for local development or an explicitly approved self-hosted setup.
# Use synthetic local submissions. Never commit API keys, real contact data, or production configuration.

# Optional database integration (configure only if used)
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# Public deployment origin and host attestations. Keep these false until verified in the actual target environment.
# NEXT_PUBLIC_BASE_PATH is normally empty; GitHub Pages project sites set it during static export.
NEXT_PUBLIC_BASE_PATH=
SITE_URL=
BIKEFIX_DEPLOYMENT_TARGET=
BIKEFIX_TLS_TERMINATION_CONFIRMED=false
BIKEFIX_TRUSTED_PROXY_CONFIRMED=false
BIKEFIX_SINGLE_INSTANCE_CONFIRMED=false
BIKEFIX_BACKUP_RESTORE_CONFIRMED=false
BIKEFIX_MONITORING_CONFIRMED=false
# On Windows, explicitly verify NTFS ACLs for the private request volume.
BIKEFIX_WINDOWS_STORAGE_ACL_CONFIRMED=false

# Repair-request workflow — local development defaults to .data/repair-requests.
# Production submissions remain DISABLED unless every gate below is configured and verified.
# Use an absolute private path outside the application/public directory on a persistent server volume.
REPAIR_REQUEST_STORAGE_DIR=
REPAIR_REQUEST_DURABLE_STORAGE_CONFIRMED=false
# Configure trusted edge/WAF throttling before setting this true. In-process limiting is only an extra layer.
REPAIR_REQUEST_RATE_LIMIT_CONFIRMED=false
# Name of one header the trusted reverse proxy MUST strip from inbound traffic and overwrite with one client IP.
# Example: x-real-ip. Do not set to an unsanitized X-Forwarded-For chain.
REPAIR_REQUEST_TRUSTED_CLIENT_IP_HEADER=
# A cryptographically random secret of at least 32 characters, used only for in-memory identifier hashing.
REPAIR_REQUEST_RATE_LIMIT_SECRET=
REPAIR_REQUEST_ACCESS_CONTROL_CONFIRMED=false
REPAIR_REQUEST_AUDIT_LOG_CONFIRMED=false
# Stable internal operator identifier used only in the private operations audit log (not a real name/email).
REPAIR_REQUEST_OPERATOR_ID=
# Developer notification via the Resend REST API. Provider acceptance is not confirmed delivery.
REPAIR_REQUEST_NOTIFICATION_EMAIL=
RESEND_API_KEY=
REPAIR_REQUEST_FROM_EMAIL=
# Must remain false until the owner approves that Resend/mailboxes receive request details and their copies/retention are understood.
REPAIR_REQUEST_NOTIFICATION_PROCESSING_APPROVED=false
# Set these only after the owner approves a policy that defines treatment of unresolved records,
# deletion/anonymization, operator access and backup retention, and the cleanup job is scheduled/verified.
REPAIR_REQUEST_RETENTION_APPROVED=false
REPAIR_REQUEST_RETENTION_DAYS=
REPAIR_REQUEST_RETENTION_JOB_CONFIRMED=false

# Optional AI assistant (must not be required for the MVP)
# AI_PROVIDER_API_KEY=
